---
import "@fontsource/eb-garamond/400.css";
import "@fontsource/eb-garamond/400-italic.css";
import "@fontsource/ibm-plex-mono/400.css";
import "../styles/global.css";
import { site } from "../site";

const pending = (value: string) => value === "TODO" || value.startsWith("TODO");
const comma = site.sentence.indexOf(", ");
const line1 = comma > -1 ? site.sentence.slice(0, comma + 1) : site.sentence;
const line2 = comma > -1 ? site.sentence.slice(comma + 2) : "";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{site.name}</title>
	</head>
	<body class="landing">
		<main>
			<p class="name mono">{site.name}</p>
			<p class="sentence">
				<span>{line1}</span><br />
				{line2 && <span>{line2}</span>}
			</p>
			<nav class="mono">
				<ul>
					<li><a href="/theses">THESES</a></li>
					<li><a href="/work">WORK</a></li>
					<li><a href="/writing">WRITING</a></li>
					<li><a href="/resume.pdf">RESUME</a></li>
					<li>
						{pending(site.email) ? <span>EMAIL</span> : <a href={`mailto:${site.email}`}>EMAIL</a>}
						<span aria-hidden="true"> · </span>
						{pending(site.linkedin) ? <span>LINKEDIN</span> : <a href={site.linkedin}>LINKEDIN</a>}
					</li>
				</ul>
			</nav>
		</main>
	</body>
</html>
